# ==========================================
# ALLIN Engine – Production Environment Configuration
# ==========================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS Allowed Origin(s)
# Comma-separated list of allowed frontend origins (or * for public)
CLIENT_URL=http://localhost:5173

# SQLite Persistent Database Path
# In production containers (e.g., Docker, Railway, Render), point to a mounted persistent volume path
DB_PATH=./server/database/allin.db

# Geographic City Configuration
CITY_NAME=Guntur
CITY_CENTER_LAT=16.3067
CITY_CENTER_LNG=80.4365

# Worker Dataset Constraints
MAX_WORKERS=100000
DEFAULT_WORKERS=50
