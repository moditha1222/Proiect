# ==========================================
# ALLIN Client – Production Environment Configuration
# ==========================================

# Base API URL of your deployed Express backend (Render Web Service)
# In Vercel Project Settings > Environment Variables, set:
# Key:   VITE_API_BASE_URL
# Value: https://proiect-1.onrender.com
#
# When left unset or empty, requests fall back to relative '/api'
# (which works with local Vite proxy or when Express serves the frontend static build).
VITE_API_BASE_URL=https://proiect-1.onrender.com
