# ==========================================
# ALLIN Client – Production Environment Configuration
# ==========================================

# Base API URL
# Leave blank to use relative '/api' (when frontend is served by Express server)
# If deploying frontend independently (e.g., Vercel, Netlify, Cloudflare Pages),
# set this to the deployed backend URL (e.g. https://allin-api.yourdomain.com)
VITE_API_URL=

